{
  "name": "@johnhenry/vimble",
  "version": "0.1.0",
  "description": "Execute code in an isolated context with an injected console",
  "main": "./src/index.mjs",
  "types": "types/types.d.ts",
  "exports": {
    ".": {
      "types": "./types/types.d.ts",
      "default": "./src/index.mjs"
    },
    "./injected-console": {
      "types": "./types/types.d.ts",
      "default": "./src/injected-console.mjs"
    }
  },
  "files": [
    "src/",
    "types/"
  ],
  "scripts": {
    "test": "node --test test/index.test.mjs",
    "demo": "node demo.mjs"
  },
  "author": "John Henry <john@iamjohnhenry.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnhenry/vimble.git"
  },
  "homepage": "https://github.com/johnhenry/vimble#readme",
  "bugs": {
    "url": "https://github.com/johnhenry/vimble/issues"
  }
}
